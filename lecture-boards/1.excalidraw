      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "🎯 The Philosophical Goal of REST (Architectural Equilibrium):",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "🎯 The Philosophical Goal of REST (Architectural Equilibrium):",
      "lineHeight": 1.25,
      "index": "b8y",
      "autoResize": true
    },
    {
      "id": "138d2a8d65",
      "type": "text",
      "x": 130,
      "y": 5729,
      "width": 972,
      "height": 32,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 20868,
      "version": 2,
      "versionNonce": 1100375103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "Roy Fielding didn't invent HTTP; he reverse-engineered why the World Wide Web succeeded. By strictly adhering to these 6 constraints,\nyour API gains the same superpowers as the Web: zero-downtime evolution, multi-million concurrent user scalability, and global resilience.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Roy Fielding didn't invent HTTP; he reverse-engineered why the World Wide Web succeeded. By strictly adhering to these 6 constraints,\nyour API gains the same superpowers as the Web: zero-downtime evolution, multi-million concurrent user scalability, and global resilience.",
      "lineHeight": 1.25,
      "index": "b8z",
      "autoResize": true
    }
