      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "💻 Client Environment\nExecutes code locally\n(e.g., Client-side validator)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "💻 Client Environment\nExecutes code locally\n(e.g., Client-side validator)",
      "lineHeight": 1.25,
      "index": "b8v",
      "autoResize": true
    },
    {
      "id": "30dcbea507",
      "type": "text",
      "x": 1390,
      "y": 5530,
      "width": 624,
      "height": 81,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 93642,
      "version": 2,
      "versionNonce": 250719089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• The ONLY Optional Constraint: REST systems do NOT need to implement this.\n• What it means: Servers can temporarily extend or customize client functionality\n  by transferring executable code (e.g., JavaScript scripts, Java applets, WebAssembly).\n• Example: A web page downloading a custom chart-rendering widget or live form\n  validation script to run directly inside the browser.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• The ONLY Optional Constraint: REST systems do NOT need to implement this.\n• What it means: Servers can temporarily extend or customize client functionality\n  by transferring executable code (e.g., JavaScript scripts, Java applets, WebAssembly).\n• Example: A web page downloading a custom chart-rendering widget or live form\n  validation script to run directly inside the browser.",
      "lineHeight": 1.25,
      "index": "b8w",
      "autoResize": true
    },
