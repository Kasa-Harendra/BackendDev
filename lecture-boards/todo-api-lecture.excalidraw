      "boundElements": [],
      "updated": 1792156629982,
      "link": null,
      "locked": false,
      "text": "• 2xx (200, 201) = Everything succeeded!\n• 4xx (404) = Client sent a bad request / missing ID.\n• 5xx (500) = Backend crashed / Server bug.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "• 2xx (200, 201) = Everything succeeded!\n• 4xx (404) = Client sent a bad request / missing ID.\n• 5xx (500) = Backend crashed / Server bug.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b3j"
