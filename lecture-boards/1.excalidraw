    {
      "id": "9fec4e4433",
      "type": "text",
      "x": 768,
      "y": 5101,
      "width": 244,
      "height": 67,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 67026,
      "version": 2,
      "versionNonce": 976234463,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "❌ STATEFUL (Anti-Pattern):\nClient: \"Next page please!\"\nServer: \"Wait, who were you?\nLet me search local RAM session #882...\"\n⚠️ Breaks when load balancer scales up!",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "❌ STATEFUL (Anti-Pattern):\nClient: \"Next page please!\"\nServer: \"Wait, who were you?\nLet me search local RAM session #882...\"\n⚠️ Breaks when load balancer scales up!",
      "lineHeight": 1.25,
      "index": "b7r",
      "autoResize": true
    },
    {
      "id": "bd2a451166",
