    {
      "id": "43f84c258f",
      "type": "text",
      "x": 1390,
      "y": 5200,
      "width": 631,
      "height": 64,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 90701,
      "version": 2,
      "versionNonce": 174943857,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• Core Law: Responses MUST explicitly declare if they are cacheable or not.\n• Headers Used: Cache-Control: max-age=3600, public | ETag: \"33a-8b1\" | 304 Not Modified.\n• Superpower: Eliminates unnecessary network round-trips to the origin server.\n  Reduces server load by 80-90% and provides lightning-fast responses globally.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Core Law: Responses MUST explicitly declare if they are cacheable or not.\n• Headers Used: Cache-Control: max-age=3600, public | ETag: \"33a-8b1\" | 304 Not Modified.\n• Superpower: Eliminates unnecessary network round-trips to the origin server.\n  Reduces server load by 80-90% and provides lightning-fast responses globally.",
      "lineHeight": 1.25,
      "index": "b8A",
      "autoResize": true
    },
