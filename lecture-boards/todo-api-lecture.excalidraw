      "boundElements": [],
      "updated": 1792156629982,
      "link": null,
      "locked": false,
      "text": "1. Client sends only name, description, done in the JSON request body.\n2. Server generates a unique id (id=1), stores it, and returns '201 Created' with the full task!\n3. HTTP status 201 explicitly signals: 'Resource was created successfully'.",
      "fontSize": 12,
      "fontFamily": 1,
