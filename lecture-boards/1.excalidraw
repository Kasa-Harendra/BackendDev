      "text": "💡 Life Cycle of an HTTP Exchange:",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "💡 Life Cycle of an HTTP Exchange:",
      "lineHeight": 1.25,
      "index": "b1C",
      "autoResize": true
    },
    {
      "id": "6fae53438c",
      "type": "text",
      "x": 130,
      "y": 1548,
      "width": 667,
      "height": 70,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 31709,
      "version": 2,
      "versionNonce": 710270435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "1. Client opens TCP socket (TLS handshake over port 443)\n2. Client transmits raw HTTP Request text stream\n3. Server parses headers -> executes controller -> queries database -> formats Response\n4. Server transmits raw HTTP Response text stream -> Client parses status & JSON body",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "1. Client opens TCP socket (TLS handshake over port 443)\n2. Client transmits raw HTTP Request text stream\n3. Server parses headers -> executes controller -> queries database -> formats Response\n4. Server transmits raw HTTP Response text stream -> Client parses status & JSON body",
      "lineHeight": 1.25,
      "index": "b1D",
      "autoResize": true
    },
