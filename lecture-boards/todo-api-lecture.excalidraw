      "isDeleted": false,
      "boundElements": [],
      "updated": 1792156629982,
      "link": null,
      "locked": false,
      "text": "1. DELETE takes the target ID straight from the URL path: `DELETE /todos/1`.\n2. The server removes the item from the list/database.\n3. Common responses: 200 OK with a confirmation JSON message, or 204 No Content (clean empty success).",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "1. DELETE takes the target ID straight from the URL path: `DELETE /todos/1`.\n2. The server removes the item from the list/database.\n3. Common responses: 200 OK with a confirmation JSON message, or 204 No Content (clean empty success).",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b3X"
    },
