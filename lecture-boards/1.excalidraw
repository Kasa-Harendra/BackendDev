      "boundElements": [],
      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "• Single HTTP POST endpoint (/graphql)\n• Client requests EXACT fields needed\n• Strongly typed schema (SDL)\n• Resolvers fetch from multiple databases/APIs\n• Single request aggregates complex graphs",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "• Single HTTP POST endpoint (/graphql)\n• Client requests EXACT fields needed\n• Strongly typed schema (SDL)\n• Resolvers fetch from multiple databases/APIs\n• Single request aggregates complex graphs",
      "lineHeight": 1.25,
      "index": "b5S",
      "autoResize": true
    },
