      "link": null,
      "locked": false,
      "text": "Strict HTTP API Contract",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "Strict HTTP API Contract",
      "lineHeight": 1.25,
      "index": "b7l",
      "autoResize": true
    },
    {
      "id": "081a1a1c5b",
      "type": "text",
      "x": 130,
      "y": 5210,
      "width": 575,
      "height": 64,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 20131,
      "version": 2,
      "versionNonce": 1387573233,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• Core Law: User Interface concerns are strictly separated from Data Storage.\n• Independent Evolution: You can completely rewrite the frontend in React Native\n  or Flutter without changing a single line of backend database code!\n• Portability: The same API backend powers Web, iOS, Android, and 3rd-party bots.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Core Law: User Interface concerns are strictly separated from Data Storage.\n• Independent Evolution: You can completely rewrite the frontend in React Native\n  or Flutter without changing a single line of backend database code!\n• Portability: The same API backend powers Web, iOS, Android, and 3rd-party bots.",
      "lineHeight": 1.25,
      "index": "b7m",
      "autoResize": true
    },
