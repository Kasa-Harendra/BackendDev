      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "📌 REST Architectural Characteristics in Practice:",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "📌 REST Architectural Characteristics in Practice:",
      "lineHeight": 1.25,
      "index": "b6o",
      "autoResize": true
    },
    {
      "id": "49f35a5e9d",
      "type": "text",
      "x": 130,
      "y": 4718,
      "width": 868,
      "height": 64,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 34697,
      "version": 2,
      "versionNonce": 1083859935,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• Half-Duplex Communication: Strict Request ➔ Response cycle. Client speaks first, server replies.\n• Unidirectional Initiation: Server can NEVER push data to the client without a prior client request.\n• Statelessness: Server keeps zero client session state between requests. Every request carries auth token.\n• Polling Waste: To get live updates in REST, clients must poll (e.g., GET /status every 2 seconds) creating huge overhead!",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Half-Duplex Communication: Strict Request ➔ Response cycle. Client speaks first, server replies.\n• Unidirectional Initiation: Server can NEVER push data to the client without a prior client request.\n• Statelessness: Server keeps zero client session state between requests. Every request carries auth token.\n• Polling Waste: To get live updates in REST, clients must poll (e.g., GET /status every 2 seconds) creating huge overhead!",
      "lineHeight": 1.25,
      "index": "b6p",
      "autoResize": true
    },
