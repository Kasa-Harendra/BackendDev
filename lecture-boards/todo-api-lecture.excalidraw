      "boundElements": [],
      "updated": 1792156629982,
      "link": null,
      "locked": false,
      "text": "• POST & PUT send data inside the Request Body (JSON).\n• GET & DELETE use URL path params (/todos/1) and no body.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "• POST & PUT send data inside the Request Body (JSON).\n• GET & DELETE use URL path params (/todos/1) and no body.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b3g"
    },
