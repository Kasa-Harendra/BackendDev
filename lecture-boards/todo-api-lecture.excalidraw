    },
    {
      "id": "elem_382",
      "type": "text",
      "x": 1315,
      "y": 2202,
      "width": 709,
      "height": 45,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
