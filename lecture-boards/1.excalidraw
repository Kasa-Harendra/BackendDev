      "isDeleted": false,
      "boundElements": [],
      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "• When to use JSON: 95% of web/mobile REST APIs, microservice data exchange, browser communication.\n• When to use XML: Banking/fintech legacy APIs, SOAP protocols, Android XML layouts, SVG vectors, RSS feeds.\n• When to use YAML: CI/CD pipelines (GitHub Actions, GitLab), Docker Compose, Kubernetes manifests, OpenAPI docs.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• When to use JSON: 95% of web/mobile REST APIs, microservice data exchange, browser communication.\n• When to use XML: Banking/fintech legacy APIs, SOAP protocols, Android XML layouts, SVG vectors, RSS feeds.\n• When to use YAML: CI/CD pipelines (GitHub Actions, GitLab), Docker Compose, Kubernetes manifests, OpenAPI docs.",
      "lineHeight": 1.25,
      "index": "b2K",
      "autoResize": true
    },
