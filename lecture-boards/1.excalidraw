      "isDeleted": false,
      "boundElements": [],
      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "• Action/function-oriented (e.g. UserService.GetUser)\n• Protocol Buffers (.proto) binary format\n• Runs over HTTP/2 with multiplexing\n• Bi-directional full streaming support\n• Auto-generates client SDKs in 10+ languages",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "• Action/function-oriented (e.g. UserService.GetUser)\n• Protocol Buffers (.proto) binary format\n• Runs over HTTP/2 with multiplexing\n• Bi-directional full streaming support\n• Auto-generates client SDKs in 10+ languages",
      "lineHeight": 1.25,
      "index": "b5j",
      "autoResize": true
    },
