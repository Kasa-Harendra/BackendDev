    },
    {
      "id": "elem_137",
      "type": "text",
      "x": 95,
      "y": 490,
      "width": 738,
      "height": 48,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1073,
      "version": 2,
      "versionNonce": 1117577716,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792156629981,
      "link": null,
      "locked": false,
      "text": "• You (The Client): Sit at the table with a menu. You cannot walk into the kitchen directly.\n• The Waiter (The API): Takes your order, brings it to the chef, and carries the cooked food back.\n• The Kitchen (The Database): Holds ingredients, cooks the dish, and hands it to the waiter.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• You (The Client): Sit at the table with a menu. You cannot walk into the kitchen directly.\n• The Waiter (The API): Takes your order, brings it to the chef, and carries the cooked food back.\n• The Kitchen (The Database): Holds ingredients, cooks the dish, and hands it to the waiter.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aa"
    },
