    },
    {
      "id": "33c93dd03f",
      "type": "text",
      "x": 1048,
      "y": 5101,
      "width": 267,
      "height": 67,
      "angle": 0,
      "strokeColor": "#087f5b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 29059,
      "version": 2,
      "versionNonce": 1790825471,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "✅ STATELESS (REST Way):\nClient: [Auth: Bearer JWT] GET /items?page=2\nServer: \"Token verified, page 2 returned!\"\n✨ Any server replica in the world can\nhandle this request with ZERO memory sync!",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "✅ STATELESS (REST Way):\nClient: [Auth: Bearer JWT] GET /items?page=2\nServer: \"Token verified, page 2 returned!\"\n✨ Any server replica in the world can\nhandle this request with ZERO memory sync!",
      "lineHeight": 1.25,
      "index": "b7t",
      "autoResize": true
    },
    {
      "id": "f654ae46aa",
      "type": "text",
      "x": 760,
      "y": 5210,
      "width": 617,
      "height": 81,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 83833,
      "version": 2,
      "versionNonce": 129544049,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• Core Law: Server stores NO client session state between requests.\n• Self-Contained: Every single HTTP request contains ALL context (Auth token,\n  query params, filters) needed to understand and fulfill it.\n• Massive Scalability: Horizontal autoscaling is trivial — spin up 100 server instances\n  behind a Load Balancer; requests can hit any instance randomly without failure!",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Core Law: Server stores NO client session state between requests.\n• Self-Contained: Every single HTTP request contains ALL context (Auth token,\n  query params, filters) needed to understand and fulfill it.\n• Massive Scalability: Horizontal autoscaling is trivial — spin up 100 server instances\n  behind a Load Balancer; requests can hit any instance randomly without failure!",
      "lineHeight": 1.25,
      "index": "b7u",
      "autoResize": true
    },
