      "versionNonce": 1805521759,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791725283669,
      "link": null,
      "locked": false,
      "text": "• Core Law: Client cannot tell whether it connects directly to the end server or a proxy.\n• Intermediary Transparency: Security firewalls, caching layers, rate limiters, and SSL\n  terminators can be inserted, swapped, or removed without the client knowing!\n• Security Boundary: End databases and business workers are safely hidden behind\n  multiple defensive tiers — never exposed directly to public internet.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "• Core Law: Client cannot tell whether it connects directly to the end server or a proxy.\n• Intermediary Transparency: Security firewalls, caching layers, rate limiters, and SSL\n  terminators can be inserted, swapped, or removed without the client knowing!\n• Security Boundary: End databases and business workers are safely hidden behind\n  multiple defensive tiers — never exposed directly to public internet.",
      "lineHeight": 1.25,
      "index": "b8l",
      "autoResize": true
    },
