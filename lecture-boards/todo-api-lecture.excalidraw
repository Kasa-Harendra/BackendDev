      "isDeleted": false,
      "boundElements": [],
      "updated": 1792156629982,
      "link": null,
      "locked": false,
      "text": "✅ Correct: GET /todos, POST /todos\n❌ Bad: /get_tasks, /create_new_todo\nThe HTTP verb (GET, POST) already describes the action!",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 9,
      "containerId": null,
      "originalText": "✅ Correct: GET /todos, POST /todos\n❌ Bad: /get_tasks, /create_new_todo\nThe HTTP verb (GET, POST) already describes the action!",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b3d"
    },
