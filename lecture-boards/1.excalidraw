      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "Calling the method does NOT alter server state.\nIt is read-only. Browsers can safely pre-fetch\nor cache it without side effects.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "Calling the method does NOT alter server state.\nIt is read-only. Browsers can safely pre-fetch\nor cache it without side effects.",
