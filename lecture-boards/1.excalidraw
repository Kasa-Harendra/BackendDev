    {
      "id": "64eab0aecf",
      "type": "text",
      "x": 1150,
      "y": 2128,
      "width": 384,
      "height": 259,
      "angle": 0,
      "strokeColor": "#51cf66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 46137,
      "version": 2,
      "versionNonce": 1086122979,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791394164696,
      "link": null,
      "locked": false,
      "text": "from pydantic import BaseModel, EmailStr, Field\nfrom typing import Literal\n\nclass UserCreateSchema(BaseModel):\n    name: str = Field(min_length=2, max_length=50)\n    email: EmailStr\n    age: int = Field(gt=0, le=120)\n    role: Literal[\"admin\", \"member\"] = \"member\"\n\nclass UserResponseSchema(BaseModel):\n    id: int\n    name: str\n    email: EmailStr\n    created_at: str\n    class Config:\n        from_attributes = True",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "from pydantic import BaseModel, EmailStr, Field\nfrom typing import Literal\n\nclass UserCreateSchema(BaseModel):\n    name: str = Field(min_length=2, max_length=50)\n    email: EmailStr\n    age: int = Field(gt=0, le=120)\n    role: Literal[\"admin\", \"member\"] = \"member\"\n\nclass UserResponseSchema(BaseModel):\n    id: int\n    name: str\n    email: EmailStr\n    created_at: str\n    class Config:\n        from_attributes = True",
      "lineHeight": 1.25,
      "index": "b2l",
      "autoResize": true
    },
